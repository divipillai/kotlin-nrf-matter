# ========================================
# Kotlin SwiftPM interop
# ========================================

# Gradle regenerates the whole linked-package scaffolding under
# .swiftpm-locks/*/swiftImport/ on every build: Package.swift, the subpackage
# manifests, and the ObjC shims. It is a duplicate of the copy Xcode actually
# builds (iosApp/KotlinMultiplatformLinkedPackage/), and tracking both means
# they drift -- the tracked copy here still declared a `_shared` subpackage the
# Xcode copy no longer has, and pinned ios-matter a second time.
#
# Package.resolved is the exception and stays tracked: it is Gradle's persisted
# lockfile, and check_swiftpm_lockfiles.sh compares it against Xcode's to catch
# exactly this kind of drift.
.swiftpm-locks/*/swiftImport/*
!.swiftpm-locks/*/swiftImport/Package.resolved

# The vendored ios-matter package (/ios-matter) is built in place, so SwiftPM
# and Xcode leave per-user state next to its manifest: .build/ when it is built
# from the command line, .swiftpm/ scheme management when Xcode opens it.
# The sources and Package.swift are tracked; these are not.
/ios-matter/.build/
/ios-matter/.swiftpm/

