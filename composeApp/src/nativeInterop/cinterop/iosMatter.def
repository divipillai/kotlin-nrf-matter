# cinterop bindings for the vendored ios-matter Swift package.
#
# The Swift sources are compiled to a static library by the `iosMatterStaticLib*`
# Gradle tasks (see composeApp/build.gradle.kts), which also emit the
# Swift-generated Objective-C header consumed below. Only the `@objc public`
# surface of ios-matter appears in that header -- everything Kotlin uses is
# annotated for exactly this reason.
#
# includeDirs, libraryPaths and staticLibraries are NOT set here: they differ per
# Kotlin/Native target, so the cinterop DSL passes them per target instead.

package = iosMatter
language = Objective-C

# Consumed as a Clang module, not as a bare header. The Swift-generated header does
# `@import Matter;`/`@import Security;`, which only parses with modules enabled --
# and cinterop rejects `headers` in modules mode ("cinterop doesn't support having
# headers in -fmodules mode"). Swift emits `ios-matter.modulemap` next to the
# header for exactly this purpose; `-fmodule-map-file` is passed per target.
modules = ios_matter

# The module map says `export *`, so without this the re-exported Foundation,
# Matter and Security declarations would all be translated too -- bloating the
# klib and clashing with the platform.* packages that already declare them.
excludeDependentModules = true

# Required whenever `modules` is used: cinterop keeps Clang modules off by default
# and fails with "Cannot load module 'ios_matter'" without this.
compilerOpts = -fmodules

# The archived Swift objects reference these frameworks. Foundation, Combine and
# OSLog come in with the Swift runtime; these three do not and would otherwise
# surface as undefined symbols only at final app link.
linkerOpts = -framework Matter -framework MatterSupport -framework Security
