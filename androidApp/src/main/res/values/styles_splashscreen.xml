<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Launch theme shown while the app process starts. -->
    <style name="NordicTheme.SplashScreen" parent="Theme.SplashScreen">
        <!-- Android 12+ system splash screen. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>
        <item name="windowSplashScreenAnimationDuration">1005</item>
        <item name="windowSplashScreenBackground">@color/md_theme_background</item>
        <item name="postSplashScreenTheme">@style/NordicTheme</item>

        <!-- Pre-Android 12 fallback. -->
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>
</resources>